# Creditra Frontend - Environment Variables Template
# Copy this file to .env or .env.local to configure your local development environment.

# Backend REST API base URL for indexer, risk score, and credit lines.
# Default: http://localhost:3000
# Status: Currently unused directly in client (mocked/injected provider architecture)
VITE_API_URL=http://localhost:3000

# Minimum repayment amount (USD) requiring typed confirmation in review modal.
# Default: 5000 (Set to 0 to disable guard)
# Status: Actively consumed in src/utils/amountValidation.ts
VITE_REPAY_CONFIRM_THRESHOLD=5000
