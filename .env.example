# ─── Credit network ───────────────────────────────────────────────────────────
# Every Stellar/Soroban setting is resolved by src/config/creditNetwork.ts.
# Horizon, Soroban RPC, wallet network checks and explorer links all read the
# same validated configuration.

# Network the app is built for: TESTNET (default) or PUBLIC.
VITE_STELLAR_NETWORK=TESTNET

# Optional overrides. Defaults follow the selected network.
# VITE_HORIZON_URL=https://horizon-testnet.stellar.org
# VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Optional. Must match the selected network. Defaults:
#   TESTNET -> Test SDF Network ; September 2015
#   PUBLIC  -> Public Global Stellar Network ; September 2015
# A mismatched value fails validation with a ConfigError naming this variable.
# The legacy names VITE_STELLAR_NETWORK_PASSTHRASE and VITE_NETWORK_PASSPHRASE
# are no longer read; setting either logs a warning.
# VITE_STELLAR_NETWORK_PASSPHRASE=

# Optional server-sent-events endpoint for in-app notifications
#VITE_NOTIFICATIONS_SSE_URL=https://api.example.com/notifications/events

# Deployed Creditra contract address (starts with "C", 56 characters).
# Optional for the mock data source; required when VITE_CREDIT_DATA_SOURCE=soroban.
# VITE_CREDIT_CONTRACT_ID=

# Credit data source: mock (default) or soroban.
VITE_CREDIT_DATA_SOURCE=mock

# ─── Settlement / IPFS ────────────────────────────────────────────────────────
# VITE_SETTLEMENT_ASSET_CODE=
# VITE_SETTLEMENT_ASSET_ISSUER=
# VITE_IPFS_GATEWAY=

# ─── Build-time feature flags ─────────────────────────────────────────────────
# Only the exact values "true" or "1" enable a flag; everything else is off.
# VITE_FEATURE_COLLATERAL_SWAP=false
# VITE_FEATURE_AUTOPAY=false
# SEP-10 wallet authentication endpoint and its Stellar.toml home domain.
# Both must be configured to enable wallet sign-in; values are public.
#VITE_SEP10_AUTH_URL=https://auth.example.com/sep10
#VITE_SEP10_HOME_DOMAIN=example.com

