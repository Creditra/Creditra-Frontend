# Stellar credit network configuration.
# All values are public; do not put secrets here.
# Defaults target Stellar testnet when left unset.

# Network to use: TESTNET or PUBLIC
#VITE_STELLAR_NETWORK=TESTNET

# Horizon API base URL
#VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC URL
#VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (testnet default)
#VITE_STELLAR_NETWORK_PASSTHRASE=Test Stellar Network ; February 2015

# Credit contract id (56-character C... strkey)
#VITE_CREDIT_CONTRACT_ID=
